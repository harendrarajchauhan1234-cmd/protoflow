              }
            },
            ".image-wrapper img": {
              "width": "100%",
              "object-fit": "cover"
            },
            ".mbr-text, .cost, .mbr-section-btn": {
              "color": "#ffffff"
            },
            ".mbr-title": {
              "color": "#ffffff"
            }
