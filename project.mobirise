          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content8\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"11\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Stylized\" name=\"stylizedCounters\" checked>\n        <input type=\"checkbox\" title=\"Mark\" name=\"mark\" checked condition=\"stylizedCounters\">\n        <select title=\"Type\" name=\"countersType\" condition=\"stylizedCounters\">\n            <option value=\"default\" selected>Сircle Fill</option>\n            <option value=\"circle\">Circle</option>\n            <option value=\"square\">Square</option>\n        </select>\n        <input type=\"color\" name=\"iconColor\" title=\"Color\" value=\"#393193\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#f7f7f7\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"counter-container col-md-12 col-lg-{{textWidth}}\">\n                <h4 class=\"mbr-section-title mbr-fonts-style mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\"><div><b>Every Protoflow™</b> capsule is designed to provide a convenient blend of carefully selected ingredients that complement your daily wellness routine. The formula is intended to support overall well-being while fitting easily into a consistent lifestyle.</div></h4>\n                <div class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" data-multiline mbr-article>\n                    <ul>\n                        <li><span style=\"font-size: 20.8px;\"><b>Carefully Selected Nutrients –</b> Essential nutritional components designed to complement a balanced daily diet.</span></li><li><span style=\"font-size: 20.8px;\"><b>Botanical Extracts – </b>Plant-based ingredients selected for their naturally occurring wellness properties.</span></li><li><span style=\"font-size: 20.8px;\"><b>Antioxidant Support – </b>Ingredients that may complement the body's natural antioxidant defenses.</span></li><li><span style=\"font-size: 20.8px;\"><b>Metabolic Support Nutrients – </b>Selected compounds intended to support normal metabolic processes.</span></li><li><span style=\"font-size: 20.8px;\"><b>Digestive Wellness Support –</b> Ingredients that can complement healthy digestion and overall gut wellness.</span></li><li><span style=\"font-size: 20.8px;\"><b>Daily Energy Support –</b> Nutritional components designed to complement normal energy production.</span></li><li><span style=\"font-size: 20.8px;\"><b>Natural Plant Compounds – </b>Botanical components that contribute to the formula's overall nutritional profile.</span></li><li><span style=\"font-size: 20.8px;\"><b>Supporting Ingredients –</b> Additional components included to create a convenient, well-rounded daily supplement.</span></li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content8-1l",
